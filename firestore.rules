rules_version = '2';
// Jede Person darf nur ihre eigenen Daten lesen und schreiben.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /days/{day} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
